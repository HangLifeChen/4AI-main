{
  "name": "agent-meme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:dev": "cross-env NODE_ENV=development next build",
    "start:dev": "cross-env NODE_ENV=development next start -p 3000",
    "build:prod": "cross-env NODE_ENV=production next build",
    "start:prod": "cross-env NODE_ENV=production next start -p 3000",
    "build:lab": "cross-env NODE_ENV=test NEXT_PUBLIC_ENV=test next build",
    "start:lab": "cross-env NODE_ENV=test NEXT_PUBLIC_ENV=test next start -p 4000",
    "lab": "npm run build:lab && npm run restart:lab",
    "restart:lab": "pm2 restart 4bsc_meme_lab || pm2 start npm --name 4bsc_meme_lab -- run start:lab",
    "prod": "npm run build:prod && npm run restart:prod",
    "restart:prod": "pm2 restart 4bsc_meme_prod || pm2 start npm --name 4bsc_meme_prod -- run start:prod",
    "pull:prod": "git reset --hard origin/main",
    "pull:lab": "git reset --hard origin/lab"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.774.0",
    "@aws-sdk/s3-request-presigner": "3.774.0",
    "@gsap/react": "^2.1.2",
    "@heroui/react": "2.7.5",
    "@hookform/resolvers": "^5.2.2",
    "@nebul/rich-text-editor": "^0.0.14",
    "@paper-design/shaders-react": "0.0.57",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@reown/appkit": "1.7.20",
    "@reown/appkit-adapter-wagmi": "1.7.20",
    "@tanstack/react-query": "^5.90.2",
    "@wagmi/core": "^2.22.0",
    "ahooks": "^3.9.5",
    "animate.css": "4.1.1",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "github-markdown-css": "5.8.1",
    "gsap": "^3.13.0",
    "lodash": "^4.17.21",
    "lottie-react": "2.4.1",
    "lucide-react": "^0.545.0",
    "mini-svg-data-uri": "1.4.4",
    "motion": "^12.23.22",
    "next": "15.5.9",
    "ogl": "^1.0.11",
    "postprocessing": "^6.38.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-dropzone": "14.3.8",
    "react-hook-form": "7.54.2",
    "react-markdown": "10.1.0",
    "recharts": "2.15.4",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar-hide": "2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.181.2",
    "viem": "^2.38.0",
    "wagmi": "^3.0.1",
    "wowjs": "1.1.3",
    "zod": "^4.1.12"
  },
  "overrides": {
    "motion": {
      "react": "19.0.0",
      "react-dom": "19.0.0"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@heroui/shared-utils",
      "@parcel/watcher",
      "@reown/appkit",
      "bufferutil",
      "keccak",
      "sharp",
      "utf-8-validate"
    ]
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "postcss": "^8.5.6",
    "sass": "^1.93.2",
    "tailwindcss": "3.4.1",
    "typescript": "^5"
  }
}